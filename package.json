{
  "name": "onyx",
  "version": "1.1.0",
  "description": "Premium macOS comic reader built with Tauri and React",
  "private": true,
  "author": {
    "name": "Sinen Ernest"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "build": "tauri build",
    "build:mac:intel": "tauri build --target x86_64-apple-darwin",
    "build:mac:apple": "tauri build --target aarch64-apple-darwin",
    "build:mac:all": "tauri build --target universal-apple-darwin",
    "start": "npm run dev",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/dom": "^10.4.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
